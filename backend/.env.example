# Backend configuration — copy to backend/.env and fill in real values.
# Never commit the real .env (it is gitignored). Values below are examples.

# ── Required ────────────────────────────────────────────────────────────────

# Postgres connection. Use the Supabase SESSION pooler URL (port 5432).
# Accepts postgres:// or postgresql://; the +psycopg2 driver tag is added
# automatically in service/config.py.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Secret used to sign/verify JWT access tokens. MUST be set and at least
# 32 characters (auth fails clearly otherwise). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public origin of the deployed frontend, added to the CORS allowlist alongside
# localhost. Omit a trailing slash (it is stripped if present).
FRONTEND_URL=http://localhost:3000

# ── Optional — server bind (sensible defaults shown) ────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# When true, students see AI grades immediately without teacher approval.
# Default false (teacher review required).
AI_GRADES_AUTO_VISIBLE=false

# ── Optional — AI test importer & AI Writing/Speaking grading ───────────────
# Provider for the AI importer: gemini (default) | claude | local.
LLM_PROVIDER=gemini
# Google Gemini (free tier) — needed for gemini importer + AI grading + explanations.
GEMINI_API_KEY=
# Gemini model id (default gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
# Anthropic Claude — only needed when LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=

# ── Optional — uploads (Writing charts, Listening/Speaking audio) ───────────
# Supabase Storage. The service key can write to Storage, so it is SERVER-SIDE
# ONLY — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Optional — abuse protection ──────────────────────────────────────────────
# Global per-IP request budget (per minute) enforced on every /api route.
# Endpoint-specific limits (auth, AI calls, daily AI quotas) are separate and
# tighter. The default is generous — the exam room autosaves answers.
GLOBAL_RATE_LIMIT_PER_MIN=240

# ── Optional — monitoring & media security ──────────────────────────────────
# Sentry error tracking (create a free project at sentry.io and paste its DSN).
SENTRY_DSN=
# How long signed media links (speaking audio, charts) stay valid, in seconds.
SIGNED_URL_TTL_SECONDS=21600

# ── Optional — customer features ─────────────────────────────────────────────
# Transactional email (password reset + verification). Free key: resend.com.
# Without these, emails are logged to the server console instead of sent.
RESEND_API_KEY=
MAIL_FROM=Bandly <onboarding@resend.dev>
# Google sign-in: OAuth 2.0 Web client ID from console.cloud.google.com
# (APIs & Services -> Credentials). Set the SAME value as VITE_GOOGLE_CLIENT_ID
# in the frontend build environment (Cloudflare Pages).
GOOGLE_CLIENT_ID=
